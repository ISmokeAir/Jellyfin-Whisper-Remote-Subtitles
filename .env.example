# Jellyfin server configuration
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=your_api_key_here

# Idle detection settings
IDLE_THRESHOLD_SECONDS=600

# Whisper model settings (tiny, base, small, medium, large-v2, large-v3)
WHISPER_MODEL=medium

# Compute type (float16 for >=8GB VRAM, int8 for 6GB cards like RTX 2060)
COMPUTE_TYPE=float16

# Subtitle languages — comma-separated ISO 639-2/B codes
# Whisper transcribes in the detected language, then translates to English if needed.
# Example: "eng"       → English transcription only
#          "eng,rum"   → original-language transcription + English translation uploaded
#                        as separate subtitle tracks
SUBTITLE_LANGS=eng,ron

# Default subtitle track to flag as active/default in player (e.g., eng or ron)
DEFAULT_SUBTITLE_LANG=eng

# Enable multilingual dynamic re-detection per scene (e.g., Spanish scenes in English series)
WHISPER_MULTILINGUAL=true

